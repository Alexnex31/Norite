# Norite backend configuration — copy to .env and edit, or export these directly.
#
# Every setting is read once at startup and validated before anything opens a socket, so a bad value fails
# immediately with a message naming the variable rather than surfacing later as a confusing runtime error.
# The authoritative list is backend/internal/config/config.go.
#
# .env is gitignored. Never commit real credentials.
#
# `norite instance init` writes an instance config file (TOML, /etc/norite/instance.toml by default) covering
# these same settings. Precedence, highest first: these environment variables, then that file, then the
# built-in default — a variable set here always wins. Neither is required: environment variables alone are
# a fully supported configuration, which is what the docker-compose and Kubernetes shapes both drive.
#
# Point the server at a config file with -config PATH or NORITE_CONFIG_FILE. Every key such a file may
# contain is documented in contracts/instance-config.toml.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string. No default — there is no safe guess, so an empty value fails startup.
# Use sslmode=require (or verify-full) for anything but a local socket or a private container network.
NORITE_DATABASE_URL=postgres://norite:norite@localhost:5432/norite?sslmode=disable

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP listen address. Default ":8080".
NORITE_LISTEN_ADDR=:8080

# "development" or "production". Only changes cross-cutting defaults (log format), never behavior.
# Default "development".
NORITE_ENV=development

# How long graceful shutdown drains in-flight requests before dropping them. Default "15s".
NORITE_SHUTDOWN_TIMEOUT=15s

# Honor forwarded headers when identifying the client: X-Forwarded-For for the address, X-Forwarded-Proto
# for the HSTS decision. Default false.
#
# Turn this on ONLY when the process genuinely sits behind a proxy that overwrites those headers (a
# reverse proxy you control, or the flagship's Kubernetes Ingress). The client IP is the rate limiter's
# grouping key, so trusting a client-settable header on a directly-exposed process lets any caller forge a
# fresh identity per request and walk straight through every IP-based limit.
#
# X-Real-IP and True-Client-IP are NEVER consulted, even with this on: they carry no positional
# information, so a value your proxy set is indistinguishable from one a client sent. If your proxy is
# configured to set only X-Real-IP (a common nginx recipe), also configure it to append X-Forwarded-For —
# otherwise every client collapses into one rate-limit bucket keyed by the proxy's own address.
NORITE_TRUST_PROXY_HEADERS=false

# How many trusted proxies sit between the client and this process. Only used when the above is true.
# Default 1.
#
# X-Forwarded-For is append-only, so the client's real address is the entry this many positions from the
# END of the header; everything further left is client-supplied and worthless. Use 1 for a single reverse
# proxy or Ingress, 2 for a CDN in front of one, and so on. Too low reads a proxy's address as the
# client's; too high reads a client-supplied value as trusted — it must match the real topology.
NORITE_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Database pool
# ---------------------------------------------------------------------------

# Pool size per backend replica. Defaults to the CPU count clamped to [4, 16] — deliberately small.
# Postgres treats connections as relatively heavy processes with a low default limit (often 100), and
# Norite's daemon-per-OS-user model means real demand grows with both instance popularity and how many
# devices each user runs a daemon on. If one instance outgrows a small direct pool, put PgBouncer in front
# rather than raising this a lot. See docs/architecture.md §11.
# NORITE_DB_MAX_CONNS=8
# NORITE_DB_MIN_CONNS=2

# How long startup waits for the first successful connection. Default "10s".
# NORITE_DB_CONNECT_TIMEOUT=10s

# How long startup waits for the migration advisory lock before giving up. Waiting is normal — it means
# another process is mid-migration — so this only needs to outlast a real migration. Default "2m".
# NORITE_MIGRATE_LOCK_TIMEOUT=2m

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | fatal | panic. Default "info".
NORITE_LOG_LEVEL=info

# "json" (default in production) or "console" (human-readable, default in development).
NORITE_LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Base REST limit, "<limit>-<S|M|H|D>". Default "600-M" (600 requests per minute).
#
# All IP-based limiting groups IPv6 traffic by /64 subnet rather than exact address — a single bad actor is
# routinely handed an entire /64, so per-address counting would let IPv6 traffic route around every limit
# for free. That grouping is global and not configurable. Stricter per-route limits (/auth/* first) arrive
# with the endpoints that need them.
NORITE_RATELIMIT=600-M

# ---------------------------------------------------------------------------
# Attachment storage
# ---------------------------------------------------------------------------
#
# Validated at startup from Milestone M2; read by the attachment milestones. A misconfigured instance
# fails while starting, next to every other configuration error, rather than at someone's first upload.

# "local" (disk on this machine) or "s3" (AWS S3, MinIO, or anything speaking that API). Default "local".
# NORITE_STORAGE_BACKEND=local

# Where attachments are written when the backend is "local".
# Default "/var/lib/norite/attachments" (%ProgramData%\Norite\attachments on Windows).
# NORITE_STORAGE_LOCAL_PATH=/var/lib/norite/attachments

# Required when the backend is "s3". The endpoint is needed for MinIO and other non-AWS services; leave it
# empty for AWS S3 itself, where the region determines the endpoint.
# NORITE_S3_ENDPOINT=https://minio.example.com
# NORITE_S3_REGION=us-east-1
# NORITE_S3_BUCKET=norite-attachments
# NORITE_S3_ACCESS_KEY_ID=norite

# A credential — never logged. Keep it out of shell history and out of committed files.
# NORITE_S3_SECRET_ACCESS_KEY=

# Address buckets as endpoint/bucket rather than bucket.endpoint. MinIO and most self-hosted S3
# implementations need this; AWS S3 does not. Default false.
# NORITE_S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Automatic HTTPS
# ---------------------------------------------------------------------------

# Let the backend obtain and renew its own certificate. Default false, which is what both a LAN-only
# self-hoster and the flagship need — the flagship terminates TLS at the Ingress with cert-manager, since
# every replica racing for the same Let's Encrypt certificate would hit rate limits.
# NORITE_ACME_ENABLED=false

# Both required once ACME is on: the hostname a certificate is issued for, and where the CA sends expiry
# notices. The hostname must be public and resolve to this machine.
# NORITE_ACME_DOMAIN=chat.example.com
# NORITE_ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------

# "open" (anyone may create an account) or "invite" (an instance invite code is required). Default "open".
# Enforced by the registration endpoint from Milestone M4; M4 refuses registration while set to "invite",
# and M10 adds the invite-redemption path that makes the mode usable.
# NORITE_REGISTRATION_MODE=open

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Signs access tokens (HS256). REQUIRED, with no default — the backend refuses to start without it.
# `norite instance init` generates one; by hand, use `openssl rand -base64 32`. At least 32 bytes.
#
# Never commit a real value. Changing it invalidates outstanding access tokens (15-minute TTL) but not
# refresh tokens, so clients recover on their next refresh.
NORITE_JWT_SECRET=change-me-to-at-least-32-bytes-of-randomness

# ---------------------------------------------------------------------------
# Outbound email (SMTP)
# ---------------------------------------------------------------------------

# Off by default, and a deployment-time opt-out by design: an instance with no relay still runs, and the
# features that need one — password reset today, matchmaking's email gate later — are simply unavailable
# rather than broken.
#
# Turning this on REQUIRES NORITE_SMTP_HOST, NORITE_SMTP_FROM_ADDRESS and NORITE_PUBLIC_BASE_URL. The
# backend refuses to start without them rather than failing at the first reset request.
# NORITE_SMTP_ENABLED=false

# The relay. Port defaults to 587 (submission) — 25 is server-to-server relay, blocked outbound by most
# hosting providers.
# NORITE_SMTP_HOST=smtp.example.com
# NORITE_SMTP_PORT=587

# Optional: an internal relay that accepts mail from its own network needs neither. Never commit a real
# password — this is a credential like NORITE_DATABASE_URL's.
# NORITE_SMTP_USERNAME=norite@example.com
# NORITE_SMTP_PASSWORD=

# "starttls" (default), "tls" (implicit TLS, usually port 465), or "none". Never "none" across a real
# network: it hands the relay credential to anyone on the path.
# NORITE_SMTP_ENCRYPTION=starttls

# The envelope sender and the display name beside it. Required once SMTP is on.
# NORITE_SMTP_FROM_ADDRESS=no-reply@example.com
# NORITE_SMTP_FROM_NAME=Norite

# ---------------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------------

# The origin users reach this instance on, used to build links in outbound email.
#
# Configured rather than derived: behind a reverse proxy the Host header is whatever the proxy sends, so a
# link built from it would point wherever an attacker aimed a request. Required once SMTP is on.
# NORITE_PUBLIC_BASE_URL=https://chat.example.com
