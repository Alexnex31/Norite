.env
.env.*
!.env.example

# Go
backend/bin/
*.exe
*.test
*.out
backend/**/vendor/
!backend/vendor/modules.txt
# Unnamed `go build ./...` output at each module root (the binary takes the module dir's name) —
# always use `go build -o <path>` or goreleaser instead of a bare `go build ./...` for real builds.
/backend/backend
/backend/server
/cli/cli
/cli/app
/gui/gui
/daemon/daemon
/daemon/daemond
/voiceworker/voiceworker

# goreleaser build output
/dist/

# sqlc / migrate scratch (generated code IS committed; this ignores local tool caches only)
backend/.sqlc/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/src/api/generated/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker / local data volumes
docker/.data/
docker/**/pgdata/

# OS
.DS_Store
Thumbs.db

