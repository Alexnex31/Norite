# Secrets / local config
.env
.env.*
!.env.example

# Instance config written by `norite instance init` — it holds the database password and, when object
# storage is used, an S3 secret key. Running the wizard with -o inside a checkout must never produce
# something committable. contracts/instance-config.toml is the placeholder-only reference and is tracked.
instance.toml
!contracts/instance-config.toml

# Go
backend/bin/
*.exe
*.test
*.out
backend/**/vendor/
!backend/vendor/modules.txt
# Unnamed `go build ./...` output at each module root (the binary takes the module dir's name) —
# always use `go build -o <path>` or goreleaser instead of a bare `go build ./...` for real builds.
/backend/backend
/backend/server
/cli/cli
/cli/app
/gui/gui
/daemon/daemon
/daemon/daemond
/voiceworker/voiceworker

# air (local hot-reload) build output
backend/tmp/

# goreleaser build output
/dist/

# sqlc / migrate scratch (generated code IS committed; this ignores local tool caches only)
backend/.sqlc/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/src/api/generated/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker / local data volumes
docker/.data/
docker/**/pgdata/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Logs
*.log

# Claude config
.claude/*