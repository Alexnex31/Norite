{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norite.example/contracts/voice-worker.schema.json",
  "title": "Norite daemon and voice-worker pipes",
  "description": "Source of truth for every frame between the daemon and norite-voice (docs/architecture.md §6, M28): two anonymous pipes the worker inherits, one each way, each frame JSON behind a 4-byte big-endian length, as on the attach socket. daemon/voiceipc is its Go form, and the tests at both ends validate every frame they send against this document. Trust tier (rule 16, ADR 0017 as amended at M28): reachable by no other process; the daemon trusts the worker least, decodes every frame strictly, bounds each at 65536 bytes and their rate, and kills the worker at the first violation. No frame carries an access token; Join carries the TURN credential, which reaches the SFU's port and nothing else (ADR 0023). A field added to any frame is a MINOR change.",
  "$ref": "#/$defs/Frame",
  "$defs": {
    "Frame": {
      "description": "Any frame, in either direction.",
      "oneOf": [
        {
          "$ref": "#/$defs/WorkerFrame"
        },
        {
          "$ref": "#/$defs/DaemonFrame"
        }
      ]
    },
    "WorkerFrame": {
      "description": "What the worker sends: Hello first and once, Offer once after Join, then State as its call changes, and from its first State, Devices as its microphone and speakers change (M32), DSP as its audio processing changes and, once ready, Speaking as who speaks changes (M34).",
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/Offer"
        },
        {
          "$ref": "#/$defs/State"
        },
        {
          "$ref": "#/$defs/Devices"
        },
        {
          "$ref": "#/$defs/SpeakingFrame"
        },
        {
          "$ref": "#/$defs/DSPFrame"
        }
      ]
    },
    "DaemonFrame": {
      "description": "What the daemon sends: Join once after Hello, Answer once after Offer, Rights whenever what the account may do changes after that, Subscribe and Processing whenever the person changes whom they hear or how their microphone is processed (M34), Input whenever the input mode or the push-to-talk key changes (M35), Leave when the call should end.",
      "oneOf": [
        {
          "$ref": "#/$defs/Join"
        },
        {
          "$ref": "#/$defs/Answer"
        },
        {
          "$ref": "#/$defs/RightsFrame"
        },
        {
          "$ref": "#/$defs/SubscribeFrame"
        },
        {
          "$ref": "#/$defs/ProcessingFrame"
        },
        {
          "$ref": "#/$defs/InputFrame"
        },
        {
          "$ref": "#/$defs/Leave"
        }
      ]
    },
    "Hello": {
      "type": "object",
      "description": "op 1, the worker's first frame. Checked by the attach socket's version rule, the daemon as the server.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 1
        },
        "d": {
          "type": "object",
          "required": [
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Offer": {
      "type": "object",
      "description": "op 2: the worker's SDP offer, every candidate gathered, under voiceproto.MaxOffer.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 2
        },
        "d": {
          "type": "object",
          "required": [
            "sdp"
          ],
          "additionalProperties": false,
          "properties": {
            "sdp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12288
            }
          }
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "State": {
      "type": "object",
      "description": "op 3: what the worker's call has become. ended is its last frame before it exits.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 3
        },
        "d": {
          "type": "object",
          "required": [
            "state",
            "reason",
            "devices"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "connecting",
                "ready",
                "ended"
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 256,
              "description": "Why a call ended, for a person, or empty."
            },
            "devices": {
              "description": "On an ended call, the devices that ended it, both failing as it started (M32): the daemon keeps them in its status after that end alone, and they are not decided, the start having been judged to end the call. Null after any other end, and on every other state.",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "allOf": [
                    {
                      "$ref": "#/$defs/CallDevices"
                    },
                    {
                      "properties": {
                        "microphone": {
                          "properties": {
                            "state": {
                              "enum": ["refused", "no_device", "no_session", "failed"]
                            }
                          }
                        },
                        "speakers": {
                          "properties": {
                            "state": {
                              "enum": ["refused", "no_device", "no_session", "failed"]
                            }
                          }
                        },
                        "decided": {
                          "const": false
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "if": {
            "properties": {
              "state": {
                "not": {
                  "const": "ended"
                }
              }
            }
          },
          "then": {
            "properties": {
              "devices": {
                "type": "null"
              }
            }
          }
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Devices": {
      "type": "object",
      "description": "op 4 (M32): how the call's microphone and speakers are doing, the whole of it each time either changes.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 4
        },
        "d": {
          "$ref": "#/$defs/CallDevices"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "CallDevices": {
      "type": "object",
      "description": "The call's microphone and speakers (M32).",
      "required": [
        "microphone",
        "speakers",
        "decided"
      ],
      "additionalProperties": false,
      "properties": {
        "microphone": {
          "$ref": "#/$defs/Device"
        },
        "speakers": {
          "$ref": "#/$defs/Device"
        },
        "decided": {
          "type": "boolean",
          "description": "Whether the call's start has been judged and the call goes on (D4): a join waiting on a failing microphone answers on it. A start judged to end the call says so with the ended state that follows, and its report is not decided."
        }
      }
    },
    "Device": {
      "type": "object",
      "description": "One direction's outcome. opening: being opened, or opened and not yet delivering. open: delivering audio, from its first frame. asking: the OS is asking the person (macOS). refused: the OS or the person refused it. no_device: there is none. no_session: the account is not logged in at the machine, whoever else is (Linux). failed: anything else. The worker words none of these; the client does, for its OS.",
      "required": [
        "state",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "opening",
            "open",
            "asking",
            "refused",
            "no_device",
            "no_session",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 256,
          "description": "What went wrong, for a person, or empty."
        }
      }
    },
    "Join": {
      "type": "object",
      "description": "op 10: make the call's connection and offer. The offer carries no candidate: the SFU is ICE-lite and learns the client's addresses from its checks, so the worker gathers only once the answer names the servers to gather with (M33).",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 10
        },
        "d": {
          "type": "object",
          "required": [
            "loopback",
            "processing",
            "input"
          ],
          "additionalProperties": false,
          "properties": {
            "loopback": {
              "type": "boolean",
              "description": "Admit loopback candidates, for an SFU on this machine: M26's harness and tests."
            },
            "processing": {
              "$ref": "#/$defs/Processing"
            },
            "input": {
              "$ref": "#/$defs/Input"
            }
          }
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Processing": {
      "type": "object",
      "description": "Which of the DSP's components process the microphone (M30), from the client's config.toml as the join request carried it. All off still runs RNNoise, for the voice probability the audio level's V flag follows.",
      "required": [
        "echo_cancellation",
        "noise_suppression",
        "auto_gain"
      ],
      "additionalProperties": false,
      "properties": {
        "echo_cancellation": {
          "type": "boolean",
          "description": "AEC3, with its high-pass filter, against what the speakers played."
        },
        "noise_suppression": {
          "type": "boolean",
          "description": "RNNoise's output replaces the microphone's."
        },
        "auto_gain": {
          "type": "boolean",
          "description": "AGC2's adaptive digital gain. Never the OS microphone's volume."
        }
      }
    },
    "ICEServer": {
      "type": "object",
      "required": [
        "urls",
        "username",
        "credential"
      ],
      "additionalProperties": false,
      "properties": {
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^turns?:",
            "maxLength": 512
          }
        },
        "username": {
          "type": "string",
          "maxLength": 128
        },
        "credential": {
          "type": "string",
          "maxLength": 128
        }
      },
      "description": "One TURN server with the account's credential."
    },
    "Answer": {
      "type": "object",
      "description": "op 11: the SFU's answer to the offer, the TURN servers to gather with, the call's bitrate and what the account may do in it (M33).",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 11
        },
        "d": {
          "type": "object",
          "required": [
            "sdp",
            "ice_servers",
            "bitrate",
            "rights"
          ],
          "additionalProperties": false,
          "properties": {
            "sdp": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12288
            },
            "ice_servers": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/ICEServer"
              }
            },
            "bitrate": {
              "type": "integer",
              "minimum": 0,
              "description": "The channel's bitrate, which the encoder starts at and the congestion controller never exceeds; the worker clamps it to 16000–224000, and 0 is its default."
            },
            "rights": {
              "$ref": "#/$defs/Rights"
            }
          }
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Leave": {
      "type": "object",
      "description": "op 12: end the call. The daemon then closes its pipe to the worker.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 12
        },
        "d": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {}
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Rights": {
      "type": "object",
      "description": "What the account may do in its call: send its microphone, and hear the call. A server mute or a channel without SPEAK takes the first, a server deafen the second. The client applies them; the SFU enforces neither.",
      "required": [
        "send",
        "hear"
      ],
      "additionalProperties": false,
      "properties": {
        "send": {
          "type": "boolean"
        },
        "hear": {
          "type": "boolean"
        }
      }
    },
    "RightsFrame": {
      "type": "object",
      "description": "op 13: what the account may do in the call changed (M33). Sent after the answer, any number of times.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 13
        },
        "d": {
          "$ref": "#/$defs/Rights"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "SpeakingFrame": {
      "type": "object",
      "description": "op 5 (M34): who the SFU says is speaking now, the newest list only, at most a few a second.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 5
        },
        "d": {
          "$ref": "#/$defs/Speaking"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Speaking": {
      "type": "object",
      "description": "User ids, at most a full room's.",
      "required": [
        "users"
      ],
      "additionalProperties": false,
      "properties": {
        "users": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        }
      }
    },
    "DSPFrame": {
      "type": "object",
      "description": "op 6 (M34): what the audio processing is doing, each time it changes. Join's processing is only what was asked.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 6
        },
        "d": {
          "$ref": "#/$defs/DSP"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "DSP": {
      "type": "object",
      "description": "starting while the processing compiles; running with the stages that process the microphone; failed for the rest of the call, reason saying why. RNNoise runs whenever it runs, for the audio level's V flag.",
      "required": [
        "state",
        "reason",
        "echo_cancellation",
        "noise_suppression",
        "auto_gain"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "starting",
            "running",
            "failed"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        },
        "echo_cancellation": {
          "type": "boolean"
        },
        "noise_suppression": {
          "type": "boolean"
        },
        "auto_gain": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "running"
              }
            }
          },
          "else": {
            "properties": {
              "echo_cancellation": {
                "const": false
              },
              "noise_suppression": {
                "const": false
              },
              "auto_gain": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "SubscribeFrame": {
      "type": "object",
      "description": "op 14 (M34): whom the person does not want to hear, and how many people at once, whole each time. Sent after the answer, any number of times.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 14
        },
        "d": {
          "$ref": "#/$defs/Subscribe"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Subscribe": {
      "type": "object",
      "description": "drop is the person's local mutes, which the SFU forwards nothing of and the worker plays nothing of; cap is how many slots the SFU may fill, null for every slot the worker has.",
      "required": [
        "drop",
        "cap"
      ],
      "additionalProperties": false,
      "properties": {
        "drop": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        },
        "cap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "ProcessingFrame": {
      "type": "object",
      "description": "op 15 (M34): how the person wants the microphone processed, changed during the call. Sent after the answer, any number of times.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 15
        },
        "d": {
          "$ref": "#/$defs/ProcessingChange"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "ProcessingChange": {
      "type": "object",
      "description": "The join's processing, as it now is.",
      "required": [
        "processing"
      ],
      "additionalProperties": false,
      "properties": {
        "processing": {
          "$ref": "#/$defs/Processing"
        }
      }
    },
    "InputFrame": {
      "type": "object",
      "description": "op 16 (M35): how the microphone is let through, changed during the call: the mode, or the push-to-talk key going down or up. Sent after the answer, any number of times.",
      "required": [
        "op",
        "d",
        "s",
        "t"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": 16
        },
        "d": {
          "$ref": "#/$defs/Input"
        },
        "s": {
          "type": "null"
        },
        "t": {
          "type": "null"
        }
      }
    },
    "Input": {
      "type": "object",
      "description": "How the microphone is let through (M35): by the voice it carries, or by push-to-talk, held while the daemon's key is down. The key itself never crosses the pipe.",
      "required": [
        "mode",
        "held"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "voice",
            "push_to_talk"
          ]
        },
        "held": {
          "type": "boolean",
          "description": "Whether the push-to-talk key is down; always false by voice."
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "voice"
          }
        }
      },
      "then": {
        "properties": {
          "held": {
            "const": false
          }
        }
      }
    }
  }
}
